# Production build config - loaded automatically by `vite build` (mode=production).
#
# This is the load-bearing flag for the Cloudflare deployment: it makes the SPA
# route chat, embeddings, and data through the same-origin /api/* Pages Functions
# (which hold the server-side DeepSeek + Voyage keys) instead of calling those
# services - or localhost - directly from the browser. Without it, a production
# build silently ships in "local mode" and the chat agent / sync break.
#
# Not a secret (it's baked into the public client bundle either way).
VITE_USE_API_PROXY=true
