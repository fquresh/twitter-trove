    "@tanstack/react-query": "^5.60.5",
    "idb": "^8.0.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.11.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250115.0",
