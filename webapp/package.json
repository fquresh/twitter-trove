{
  "name": "trove-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "postinstall": "node -e \"const fs=require('node:fs');for(const f of ['sql-wasm.wasm','sql-wasm-browser.wasm']){fs.copyFileSync('node_modules/sql.js/dist/'+f,'public/'+f)}\""
  },
