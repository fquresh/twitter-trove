# Copy this file to .env and fill in the values you need: cp .env.example .env
# ./trove loads .env on every run. ./trove set-key writes the API keys for you.
# Never commit .env. It is gitignored.

# ── Pipeline and chat API keys ──────────────────────────────────────────────
# OpenRouter: canonical classifier (./trove update) and image descriptions.
OPENROUTER_API_KEY=
# Voyage: embeddings for search by meaning (pipeline and webapp chat).
VOYAGE_API_KEY=
# DeepSeek: webapp chat agent. wiki_server.py passes it to the local webapp.
DEEPSEEK_API_KEY=
# Anthropic: only for ./trove update --emergent, wiki_bootstrap.py, or a claude-* vision model.
ANTHROPIC_API_KEY=

# ── Local servers ───────────────────────────────────────────────────────────
# Port for wiki_server.py when you start it directly (default 8765).
WIKI_PORT=

# ── Cloud deploy (optional; only for ./trove deploy and ./trove mcp-push) ───
# Cloudflare Pages project name. Must match `name` in webapp/wrangler.toml.
TROVE_PAGES_PROJECT=
# R2 bucket that holds the data JSONs. Must match `bucket_name` in webapp/wrangler.toml.
TROVE_R2_BUCKET=
# D1 database for sync and the MCP index. Must match `database_name` in webapp/wrangler.toml.
TROVE_D1_DB=
# Public URL of the deployed app, if not https://<TROVE_PAGES_PROJECT>.pages.dev.
TROVE_PAGES_URL=
# Cloudflare account id for R2 uploads. If empty, ./trove reads it from `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# R2 S3 API token for multipart uploads of large data files.
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
# S3 endpoint: https://<account_id>.r2.cloudflarestorage.com (derived from the account id if empty).
R2_S3_ENDPOINT=

# Cloudflare Access service token. Deploy verification uses it to read the live site.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: where wrangler keeps its login token. ./trove reads it for R2 uploads.
# Leave unset to use the default path for your OS.
# WRANGLER_CONFIG=
# XDG_CONFIG_HOME=
